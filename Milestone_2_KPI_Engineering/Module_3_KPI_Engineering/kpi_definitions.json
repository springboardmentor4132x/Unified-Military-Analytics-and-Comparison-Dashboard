{
  "kpi_definitions": {
    "power_index_rank_gap": {
      "name": "Power Index Rank Gap",
      "description": "Ranking difference between consecutive countries in military strength",
      "formula": "rank[i] - rank[i+1]",
      "formula_description": "Difference in ranking position between consecutive countries",
      "data_type": "float",
      "unit": "rank positions",
      "interpretation": "Higher value indicates larger gap to next ranked country",
      "tableau_aggregation": "SUM"
    },
    "assets_per_capita": {
      "name": "Assets Per Capita",
      "description": "Total military assets per person in population",
      "formula": "total_assets / population",
      "formula_description": "Sum of all military equipment divided by population",
      "data_type": "float",
      "unit": "assets per person",
      "interpretation": "Higher value indicates more military assets relative to population",
      "tableau_aggregation": "AVG"
    },
    "budget_to_gdp_ratio": {
      "name": "Budget-to-GDP Ratio",
      "description": "Defense spending as percentage of Gross Domestic Product",
      "formula": "(defense_budget / gdp) * 100",
      "formula_description": "Defense budget divided by GDP, expressed as percentage",
      "data_type": "float",
      "unit": "percent (%)",
      "interpretation": "Higher value indicates more defense budget relative to economic output",
      "tableau_aggregation": "AVG"
    },
    "personnel_density": {
      "name": "Personnel Density",
      "description": "Active military personnel per 1000 population",
      "formula": "(active_personnel / population) * 1000",
      "formula_description": "Active military personnel normalized per 1000 population",
      "data_type": "float",
      "unit": "personnel per 1000 population",
      "interpretation": "Higher value indicates more military personnel relative to population",
      "tableau_aggregation": "AVG"
    },
    "equipment_density": {
      "name": "Equipment Density",
      "description": "Total military equipment per 1000 square kilometers",
      "formula": "total_equipment / (land_area_km2 / 1000)",
      "formula_description": "Total equipment divided by land area in 1000 km² units",
      "data_type": "float",
      "unit": "equipment per 1000 km²",
      "interpretation": "Higher value indicates more concentrated military presence",
      "tableau_aggregation": "AVG"
    }
  },
  "derived_metrics": {
    "total_assets": {
      "name": "Total Military Assets",
      "formula": "total_aircraft + tanks + submarines + destroyers",
      "description": "Sum of major military equipment categories"
    },
    "military_power_index": {
      "name": "Military Power Index",
      "formula": "Composite score based on GlobalFirepower methodology",
      "description": "Normalized military strength ranking"
    }
  },
