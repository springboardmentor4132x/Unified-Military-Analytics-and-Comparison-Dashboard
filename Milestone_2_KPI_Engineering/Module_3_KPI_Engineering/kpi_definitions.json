  "data_formats": {
    "wide_format": {
      "description": "Each row is a country, each column is a metric/KPI",
      "use_case": "Excel analysis, Tableau direct import",
      "output_file": "military_final.xlsx"
    },
    "long_format": {
      "description": "Each row is a country-KPI combination",
      "use_case": "Dashboard flexibility, multiple visualizations",
      "output_file": "military_final_long.csv"
    }
  },
  "tableau_settings": {
